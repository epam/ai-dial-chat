# ---- Base Node ----
FROM node:24-alpine AS base
WORKDIR /app
COPY package*.json ./

# ---- Dependencies ----
FROM base AS build_dependencies
# Skip postinstall (patch-package + tools/patch-nextjs.js); overlay-sandbox does not need those patches.
RUN npm ci --legacy-peer-deps --ignore-scripts

# ---- Build ----
FROM build_dependencies AS build
COPY . .

RUN npx nx run overlay-sandbox:build

# ---- Only required dependencies ----
FROM build AS run_dependencies
WORKDIR /app/dist/apps/overlay-sandbox
RUN npm i --legacy-peer-deps --ignore-scripts

# ---- Production ----
FROM node:24-alpine AS production
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV KEEP_ALIVE_TIMEOUT=61000
ENV PORT=4200

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 -G nodejs nextjs

COPY --chown=nextjs:nodejs --from=run_dependencies /app/dist/apps/overlay-sandbox ./

USER nextjs

EXPOSE 4200

# Start the application
CMD ["sh", "-c", "npm start -- --keepAliveTimeout $KEEP_ALIVE_TIMEOUT"]
