{
  "info": {
    "name": "Chat API (1.0.0)",
    "description": "REST API for the chat application. Provides endpoints for theme configuration, authentication, and management. All endpoints return appropriate HTTP status codes (200, 400, 401, 403, 404, 502, 503) with descriptive error messages.\n\nGenerated from libs/chat-api-client/openapi.json. Contains 38 requests grouped by OpenAPI tag.\n\nAuthentication uses the Postman cookie jar. Start the OIDC flow with the login request, then call “Get current user”; its response supplies the CSRF token used by authenticated write requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const csrfToken = pm.response.headers.get('X-CSRF-Token');",
          "if (csrfToken) {",
          "  pm.collectionVariables.set('csrfToken', csrfToken);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3005", "type": "string" },
    { "key": "origin", "value": "http://localhost:4207", "type": "string" },
    { "key": "csrfToken", "value": "", "type": "string" },
    { "key": "providerId", "value": "local", "type": "string" },
    {
      "key": "callbackUrl",
      "value": "http://localhost:4207",
      "type": "string"
    },
    { "key": "deployment", "value": "deployment-name", "type": "string" },
    { "key": "modelName", "value": "model-name", "type": "string" },
    { "key": "id", "value": "resource-id", "type": "string" },
    { "key": "bucket", "value": "bucket-name", "type": "string" },
    { "key": "path", "value": "path/to/file", "type": "string" }
  ],
  "item": [
    {
      "name": "applications",
      "item": [
        {
          "name": "List application type schemas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/application-schemas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "application-schemas"]
            },
            "description": "Returns DIAL Core application type schemas visible to the authenticated user. Results are cached server-side for 60 seconds per user."
          }
        },
        {
          "name": "Get application type schema by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/application-schemas/{{id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "application-schemas", "{{id}}"]
            },
            "description": "Returns one DIAL Core application type schema by its $id. Results are cached server-side for 60 seconds per user per schema."
          }
        },
        {
          "name": "List available applications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/applications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "applications"]
            },
            "description": "Returns the list of DIAL Core applications visible to the authenticated session user. Proxies GET /openai/applications using the caller's session access token. Results are cached server-side for 30 seconds per user."
          }
        }
      ]
    },
    {
      "name": "auth",
      "item": [
        {
          "name": "List configured identity providers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/providers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "providers"]
            }
          }
        },
        {
          "name": "Start OIDC login flow",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login/{{providerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login", "{{providerId}}"]
            }
          }
        },
        {
          "name": "OIDC authorization callback",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/callback/{{providerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "callback", "{{providerId}}"]
            }
          }
        },
        {
          "name": "Log out and clear session cookie",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Origin", "value": "{{origin}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "CSRF: run an authenticated GET request first (for example “Get current user”) so the collection captures X-CSRF-Token."
          }
        },
        {
          "name": "Get current user profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Authentication: session cookie (managed automatically by the Postman cookie jar)."
          }
        }
      ]
    },
    {
      "name": "chat",
      "item": [
        {
          "name": "Send a chat completion request to DIAL Core",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Origin", "value": "{{origin}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deployment\": \"gpt-4o\",\n  \"messages\": [\n    {\n      \"id\": \"cfeaf733-4ecd-4898-ad3b-d6835c0b5fc8\",\n      \"role\": \"user\",\n      \"content\": \"Hello, how can you help me today?\",\n      \"timestamp\": \"2024-01-01T00:00:00.000Z\",\n      \"custom_content\": {\n        \"attachments\": [\n          {\n            \"index\": 0,\n            \"type\": \"type\",\n            \"title\": \"title\",\n            \"data\": \"data\",\n            \"url\": \"url\",\n            \"reference_type\": \"reference_type\",\n            \"reference_url\": \"reference_url\"\n          }\n        ],\n        \"configuration_value\": {\n          \"button\": 1\n        },\n        \"form_value\": {\n          \"field1\": \"value\",\n          \"field2\": 42\n        }\n      }\n    }\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 1024\n}\n",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chat", "completions"]
            },
            "description": "CSRF: run an authenticated GET request first (for example “Get current user”) so the collection captures X-CSRF-Token."
          }
        }
      ]
    },
    {
      "name": "config",
      "item": [
        {
          "name": "Get application feature configuration",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/config",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "config"]
            }
          }
        }
      ]
    },
    {
      "name": "conversations",
