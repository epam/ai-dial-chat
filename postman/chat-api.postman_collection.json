              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "duplicate"],
              "query": [
                {
                  "key": "path",
                  "value": "{{path}}",
                  "description": "Conversation path (uuid__name). May contain slashes."
                }
              ]
            },
            "description": "CSRF: run an authenticated GET request first (for example “Get current user”) so the collection captures X-CSRF-Token."
          }
        },
        {
          "name": "Delete selected conversations",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Origin", "value": "{{origin}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"ids\"\n  ]\n}\n",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/deletions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "deletions"]
            },
            "description": "Deletes up to 100 owned conversations in one request. Returns a result counting deleted, already-absent, and failed items. Already-absent IDs are treated as success. IDs outside the authenticated bucket are rejected with code FORBIDDEN.\n\nCSRF: run an authenticated GET request first (for example “Get current user”) so the collection captures X-CSRF-Token."
          }
        },
        {
          "name": "Delete all conversations in the user bucket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Origin", "value": "{{origin}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirm\": true\n}\n",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/deletions/all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "deletions", "all"]
            },
            "description": "Deletes every conversation in the authenticated user's bucket. Requires { confirm: true } in the request body to prevent accidental deletion. Returns a result counting deleted, already-absent, and failed items.\n\nCSRF: run an authenticated GET request first (for example “Get current user”) so the collection captures X-CSRF-Token."
          }
        }
      ]
    },
