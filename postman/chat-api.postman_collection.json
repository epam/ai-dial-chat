            "description": "CSRF: run an authenticated GET request first (for example “Get current user”) so the collection captures X-CSRF-Token."
          }
        },
        {
          "name": "List conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/list",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "list"],
              "query": [
                {
                  "key": "limit",
                  "value": "100",
                  "disabled": true,
                  "description": "Maximum number of conversations to return."
                },
                {
                  "key": "nextToken",
                  "value": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9",
                  "disabled": true,
                  "description": "Pagination cursor returned in the previous response as `nextToken`. Omit for the first page."
                },
                {
                  "key": "path",
                  "value": "{{path}}",
                  "disabled": true,
                  "description": "DIAL Core subfolder path to scope the listing. Omit or pass an empty string to list all conversations from the bucket root (\"My Files\")."
                }
              ]
            },
            "description": "Returns a flat, paginated list of all conversations for the authenticated user by calling the DIAL Core metadata endpoint with `recursive=true` on the root path."
          }
        },
        {
          "name": "Get metadata for a conversation",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/metadata?path={{path}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "metadata"],
              "query": [
                {
                  "key": "path",
                  "value": "{{path}}",
                  "description": "Conversation path (uuid__name). May contain slashes."
                },
                {
                  "key": "permissions",
                  "value": "true",
                  "disabled": true,
                  "description": "Include READ/WRITE/SHARE permissions for the requesting user"
                }
              ]
            }
          }
        },
        {
          "name": "Stream a chat completion",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Origin", "value": "{{origin}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"path\": \"gpt-4o__My Conversation__cfeaf733-4ecd-4898-ad3b-d6835c0b5fc8\",\n  \"message\": \"What is the capital of France?\",\n  \"model\": \"anthropic.claude-v3-sonnet\",\n  \"custom_content\": {\n    \"attachments\": [\n      {\n        \"index\": 0,\n        \"type\": \"type\",\n        \"title\": \"title\",\n        \"data\": \"data\",\n        \"url\": \"url\",\n        \"reference_type\": \"reference_type\",\n        \"reference_url\": \"reference_url\"\n      }\n    ],\n    \"configuration_value\": {\n      \"button\": 1\n    },\n    \"form_value\": {\n      \"field1\": \"value\",\n      \"field2\": 42\n    }\n  }\n}\n",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/conversations/completions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "conversations", "completions"]
            },
            "description": "Appends the user message to the conversation history, streams a completion from DIAL Core as SSE, and returns the raw event stream.\n\nCSRF: run an authenticated GET request first (for example “Get current user”) so the collection captures X-CSRF-Token."
          }
        },
        {
          "name": "Duplicate a conversation into the user's own bucket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Origin", "value": "{{origin}}" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "url": {
