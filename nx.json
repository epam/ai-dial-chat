{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "affected": {
    "defaultBase": "development"
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "e2e": {
      "cache": false,
      "inputs": ["default", "^production"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"]
    },
    "test:watch": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "watch": true
      }
    },
    "test:coverage": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "coverage": true
      }
    },
    "lint": {
      "cache": true,
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "maxWarnings": 30
      },
      "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"]
    },
    "lint:fix": {
      "cache": false,
      "executor": "@nx/eslint:lint",
      "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"],
      "options": {
        "fix": true,
        "maxWarnings": 30
      }
    },
    "format": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "commands": ["prettier --check {projectRoot}"]
      }
    },
    "format:fix": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["prettier --write {projectRoot}"]
      }
    },
    "unused-exports": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx ts-unused-exports {projectRoot}/tsconfig.json --showLineNumber --excludePathsFromReport='.next;dist;e2e'"
        ]
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/vitest.config.mts",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.js",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true
      }
    },
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    }
  }
}
