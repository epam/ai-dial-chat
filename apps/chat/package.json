{
  "name": "@epam/chat",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "nx": {
    "targets": {
      "test-csp-browser": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/chat",
          "command": "node --test browser-tests/csp.browser.spec.mjs"
        }
      },
      "build": {
        "dependsOn": [
          "typecheck",
          "^build"
        ]
      },
      "test-oauth-browser": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/chat",
          "command": "node --test browser-tests/toolset-oauth-popup.browser.spec.mjs"
        }
      }
    }
  }
}
