# URL of the apps/chat instance to embed via @epam/ai-dial-chat-overlay, running
# with overlay mode enabled (OVERLAY_ENABLED=true and this sandbox's dev origin
# added to ALLOWED_IFRAME_ORIGINS — see apps/chat-api/.env.template and
# libs/chat-overlay/README.md). Only VITE_-prefixed vars are exposed to client
# code by Vite, so this must keep the VITE_ prefix.
VITE_CHAT_OVERLAY_HOST=http://localhost:4207
