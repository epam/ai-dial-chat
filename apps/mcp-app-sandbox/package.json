{
  "name": "mcp-app-sandbox",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "nx serve mcp-app-sandbox"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--config-node-env=production"
          ],
          "cwd": "apps/mcp-app-sandbox"
        },
        "configurations": {
          "development": {
            "args": [
              "--config-node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/mcp-app-sandbox/dist/package.json",
          "{workspaceRoot}/apps/mcp-app-sandbox/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/mcp-app-sandbox/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "mcp-app-sandbox:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "mcp-app-sandbox:build:development"
          },
          "production": {
            "buildTarget": "mcp-app-sandbox:build:production"
          }
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/apps/mcp-app-sandbox/test-output/vitest/coverage"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "vitest run --config apps/mcp-app-sandbox/vitest.config.mts"
        }
      }
    },
    "tags": [
      "type:fixture"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-prometheus": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "multer": "2.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8"
  },
  "overrides": {
    "multer": "2.5.0",
    "proxy-addr": "2.0.8"
  }
}
