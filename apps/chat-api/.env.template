# Server Configuration
PORT=5000
API_PREFIX=api
CORS_ORIGIN=http://localhost:4207
# LOG_LEVEL=debug

# Auth / session
AUTH_SESSION_SECRET=<64-character-hex-secret>
AUTH_CALLBACK_BASE_URL=http://localhost:5000
AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:4207
# ADMIN_ROLE_NAMES=admin
# DIAL_ROLES_FIELD=dial_roles

# Header bearer-token auth (off by default; see README.md "Header bearer-token authentication")
# AUTH_HEADER_TOKEN_ENABLED=false
# AUTH_HEADER_TOKEN_ALLOWED_ISSUERS=https://accounts.google.com
# AUTH_HEADER_TOKEN_CLOCK_TOLERANCE_SECONDS=30
# AUTH_HEADER_TOKEN_JWKS_CACHE_TTL_SECONDS=600
# AUTH_HEADER_TOKEN_BUCKET_CACHE_TTL_SECONDS=60

# Auth providers: configure at least one identity provider below.
# A provider is registered only when its CLIENT_ID variable is set.
# See apps/chat-api/README.md "Auth provider environment variables" for the
# full field list per provider (Auth0, Azure AD, Azure B2C, GitLab, Google,
# Keycloak, PingID, Cognito, Okta) and apps/chat-api/AGENTS.md for migration
# notes from the old AUTH_PROVIDERS JSON variable.

# Auth0
AUTH_AUTH0_CLIENT_ID=your-client-id
AUTH_AUTH0_SECRET=<client-secret>
AUTH_AUTH0_HOST=your-tenant.auth0.com
# AUTH_AUTH0_AUDIENCE=https://your-api.example.com
# AUTH_AUTH0_NAME=Auth0
# AUTH_AUTH0_SCOPE=openid email profile offline_access
# AUTH_AUTH0_ADMIN_ROLE_NAMES=admin
# AUTH_AUTH0_DIAL_ROLES_FIELD=dial_roles

# Azure AD
# AUTH_AZURE_AD_CLIENT_ID=your-client-id
# AUTH_AZURE_AD_SECRET=<client-secret>
# AUTH_AZURE_AD_TENANT_ID=your-tenant-id

# Azure B2C
# AUTH_AZURE_B2C_CLIENT_ID=your-client-id
# AUTH_AZURE_B2C_CLIENT_SECRET=<client-secret>
# AUTH_AZURE_B2C_TENANT_ID=your-tenant
# AUTH_AZURE_B2C_USER_FLOW=B2C_1_signupsignin
# AUTH_AZURE_B2C_ISSUER=

# GitLab
# AUTH_GITLAB_CLIENT_ID=your-client-id
# AUTH_GITLAB_SECRET=<client-secret>
# AUTH_GITLAB_HOST=gitlab.com

# Google
# AUTH_GOOGLE_CLIENT_ID=your-client-id
# AUTH_GOOGLE_SECRET=<client-secret>

# Keycloak
# AUTH_KEYCLOAK_CLIENT_ID=your-client-id
# AUTH_KEYCLOAK_SECRET=<client-secret>
# AUTH_KEYCLOAK_HOST=keycloak.example.com/realms/dial

# PingID
# AUTH_PING_ID_CLIENT_ID=your-client-id
# AUTH_PING_ID_SECRET=<client-secret>
# AUTH_PING_ID_HOST=auth.pingone.com/your-env-id/as

# Cognito
# AUTH_COGNITO_CLIENT_ID=your-client-id
# AUTH_COGNITO_SECRET=<client-secret>
# AUTH_COGNITO_HOST=cognito-idp.your-region.amazonaws.com/your-user-pool-id

# Okta
# AUTH_OKTA_CLIENT_ID=your-client-id
# AUTH_OKTA_CLIENT_SECRET=<client-secret>
# AUTH_OKTA_ISSUER=https://your-domain.okta.com/oauth2/default

DEFAULT_DEPLOYMENT="deployment_id"

# Operator-authored HTML message shown in a dismissible top-of-app announcement banner.
# Unset/empty hides the banner. Dismissal is keyed by message text, so changing this
# value re-shows the banner even for users who dismissed a previous message.
# ANNOUNCEMENT_HTML_MESSAGE=Welcome to <a href="https://your-site.example.com">DIAL</a>!

# Operator-authored HTML message shown in the footer of the chat input area (desktop) and
# mobile user panel. Supports %%VERSION%% token replaced with the current app version.
# Sanitized server-side (allowlist: a span strong u em br p). Unset/empty hides the footer.
# FOOTER_HTML_MESSAGE=<p>Need help? <a href="https://your-support-site.example.com">Contact support</a>.</p>

# DIAL Configuration
# DIAL_CORE_URL=https://your-dial-core-url.example.com
# DIAL_API_VERSION=2024-10-21
# DIAL_API_KEY=your-dial-api-key

# Themes
# THEMES_CONFIG_URL=https://your-themes-config-url.example.com

# File Transfer
# FILE_UPLOAD_MAX_BYTES=536870912
# FILE_TRANSFER_TIMEOUT_MS=30000
# ARCHIVE_DOWNLOAD_CONCURRENCY=32
# ARCHIVE_UPLOAD_MAX_BYTES=536870912
# ARCHIVE_UPLOAD_MAX_FILES=1000
# ARCHIVE_UPLOAD_MAX_UNCOMPRESSED_BYTES=2147483648
# ARCHIVE_UPLOAD_TIMEOUT_MS=300000

# Voice / ASR
# ASR_MODEL=your-asr-deployment-id
# TRANSCRIBE_SIZE_LIMIT_BYTES=5242880

# Utility model (server-only; uses DIAL_API_KEY above)
# UTILITY_MODEL=your-utility-deployment-id
# LLM_CONVERSATION_NAMING_ENABLED=false
# UTILITY_NAMING_TIMEOUT_MS=10000

# Catalog
# FEATURED_MODEL_IDS=your-featured-model-id-1,your-featured-model-id-2
# HIDDEN_ENTITY_TAGS=hidden-tag-1,hidden-tag-2

# Security / CSP
# Comma-separated list of origins allowed to be embedded in an iframe (CSP frame-src,
# frame-ancestors, and X-Frame-Options coordination). Also the overlay-mode host-origin
# allowlist consumed by chat-overlay (see libs/chat-overlay/README.md). Empty/unset
# denies all embedding (frame-ancestors 'none', X-Frame-Options: SAMEORIGIN kept on).
# ALLOWED_IFRAME_ORIGINS=

# Whether the chat-overlay embedded runtime mode (libs/chat-overlay) is reachable.
# Has no effect unless ALLOWED_IFRAME_ORIGINS is also non-empty.
# OVERLAY_ENABLED=false

# Serve the overlay sandbox static app at /overlay-sandbox/.
# Intended for development/test environments only.
# OVERLAY_SANDBOX_ENABLED=false

# File Manager
# Comma-separated subset of: my_files,shared,organization. Defaults to all three when unset.
# FILE_MANAGER_AVAILABLE_TABS=my_files,shared,organization

# UI Feature toggles
# When set, becomes the complete list of enabled OverlayFeature values.
# Supports both positive flags (header, likes) and modifier/hide flags.
# ENABLED_UI_FEATURES=

# DIAL_CORE_EXTERNAL_URL=

# Interactive toolset sign-in during chat completion (client-channel)
# LIVE_CHAT_INTERACTION_ENABLED=false
# Comma-separated roles allowed to use it when the feature above is enabled; unset/empty means unrestricted
# LIVE_CHAT_INTERACTION_ENABLED_ROLES=

# Scheduled Tasks page and its sidebar navigation entry (UI shell only)
# SCHEDULED_TASKS_ENABLED=false
# Comma-separated roles allowed to use it when the feature above is enabled; unset/empty means unrestricted
# SCHEDULED_TASKS_ENABLED_ROLES=
# SCHEDULER_APP_ID=your-scheduler-application-id
# SCHEDULER_SERVICE_ID=your-scheduler-oauth-service-id
# SCHEDULER_SERVICE_TIMEOUT_MS=10000

# Custom Visualizers
# JSON array of custom visualizer registry entries. Each entry mounts an <iframe> (with a sandbox
# attribute) at the given URL to render attachments whose MIME type(s) match. Registering a URL
# grants that origin iframe privileges (downloads, popups, clipboard, fullscreen) — only list vetted visualizers.
# `title` is the postMessage namespace shared with the visualizer app; it MUST equal the `appName`
# argument passed to ChatVisualizerConnector inside the iframe app — a mismatch means the iframe
# silently never receives data.
# CUSTOM_VISUALIZERS=[{"title":"my-viz","url":"https://viz.example.com","contentType":"application/x-my-viz,application/x-my-viz-v2"}]
