# Server Configuration
PORT=5000
API_PREFIX=api
# Allowed CORS origin. Defaults to AUTH_CALLBACK_BASE_URL below when unset; set explicitly
# only when the frontend is served from a different origin than the auth callback base.
# CORS_ORIGIN=http://localhost:4207
# LOG_LEVEL=debug

# Corporate proxy for outbound HTTP(S) calls to the internet (OIDC discovery/token/JWKS
# requests, the themes service, and any externally-reachable DIAL Core). Standard env vars,
# read directly (lowercase variants are also honored); see README.md "Corporate proxy support".
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal

# Auth / session
AUTH_SESSION_SECRET=<64-character-hex-secret>
AUTH_CALLBACK_BASE_URL=http://localhost:5000
# Where the IdP redirects the browser after logout. Defaults to AUTH_CALLBACK_BASE_URL
# above when unset; set explicitly only when it must differ.
# AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:4207
# Rolling session lifetime, renewed after successful token refresh (default: 30 days).
# Integer seconds, 1..2147483647. Applies at login and renewal, independently of scopes.
# AUTH_SESSION_MAX_AGE_SECONDS=2592000
# Local HTTP smoke only. Also disables HSTS and CSP upgrade-insecure-requests.
# AUTH_COOKIE_SECURE=false
# ADMIN_ROLE_NAMES=admin
# DIAL_ROLES_FIELD=dial_roles
# Cookie names left over from a previous deployment's auth stack, to be
# actively expired on this one (see README.md "Legacy cookie cleanup").
# AUTH_LEGACY_COOKIE_NAMES=__Secure-next-auth.session-token,__Secure-next-auth.callback-url,__Host-next-auth.csrf-token,__Secure-next-auth.pkce.code_verifier,__Secure-next-auth.state,__Secure-next-auth.nonce

# Header bearer-token auth (off by default; see README.md "Header bearer-token authentication")
# AUTH_HEADER_TOKEN_ENABLED=false
# AUTH_HEADER_TOKEN_ALLOWED_ISSUERS=https://accounts.google.com
# AUTH_HEADER_TOKEN_CLOCK_TOLERANCE_SECONDS=30
# AUTH_HEADER_TOKEN_JWKS_CACHE_TTL_SECONDS=600
# AUTH_HEADER_TOKEN_BUCKET_CACHE_TTL_SECONDS=60

# Auth providers: configure at least one identity provider below.
# A provider is registered only when its CLIENT_ID variable is set.
# See apps/chat-api/README.md "Auth provider environment variables" for the
# full field list per provider (Auth0, Azure AD, Azure B2C, GitLab, Google,
# Keycloak, PingID, Cognito, Okta).
#
# Every AUTH_*_HOST value accepts either a bare host (HTTPS is assumed) or a
# full http(s) URL, so a provider reachable only over plain HTTP can be
# configured as, for example, http://keycloak.internal:8080/realms/dial.

# Auth0
AUTH_AUTH0_CLIENT_ID=your-client-id
AUTH_AUTH0_SECRET=<client-secret>
AUTH_AUTH0_HOST=your-tenant.auth0.com
# AUTH_AUTH0_AUDIENCE=https://your-api.example.com
# AUTH_AUTH0_NAME=Auth0
# AUTH_AUTH0_SCOPE=openid email profile offline_access
# AUTH_AUTH0_ADMIN_ROLE_NAMES=admin
# AUTH_AUTH0_DIAL_ROLES_FIELD=dial_roles

# Azure AD
# AUTH_AZURE_AD_CLIENT_ID=your-client-id
# AUTH_AZURE_AD_SECRET=<client-secret>
# AUTH_AZURE_AD_TENANT_ID=your-tenant-id

# Azure B2C
# AUTH_AZURE_B2C_CLIENT_ID=your-client-id
# AUTH_AZURE_B2C_CLIENT_SECRET=<client-secret>
# AUTH_AZURE_B2C_TENANT_ID=your-tenant
# AUTH_AZURE_B2C_USER_FLOW=B2C_1_signupsignin
# AUTH_AZURE_B2C_ISSUER=

# GitLab
# AUTH_GITLAB_CLIENT_ID=your-client-id
# AUTH_GITLAB_SECRET=<client-secret>
# AUTH_GITLAB_HOST=gitlab.com

# Google
# AUTH_GOOGLE_CLIENT_ID=your-client-id
# AUTH_GOOGLE_SECRET=<client-secret>

# Keycloak
# AUTH_KEYCLOAK_CLIENT_ID=your-client-id
# AUTH_KEYCLOAK_SECRET=<client-secret>
# AUTH_KEYCLOAK_HOST=keycloak.example.com/realms/dial
# Or a full URL: AUTH_KEYCLOAK_HOST=http://keycloak.internal:8080/realms/dial

# If an OIDC provider uses a certificate issued by a private CA, mount the
# PEM-encoded CA bundle into the container and set this path before startup.
# See README.md "Trusting a private certificate authority". Never disable TLS
# verification with NODE_TLS_REJECT_UNAUTHORIZED=0.
# NODE_EXTRA_CA_CERTS=/certificates/company-ca.pem

# PingID
# AUTH_PING_ID_CLIENT_ID=your-client-id
# AUTH_PING_ID_SECRET=<client-secret>
# AUTH_PING_ID_HOST=auth.pingone.com/your-env-id/as

# Cognito
# AUTH_COGNITO_CLIENT_ID=your-client-id
# AUTH_COGNITO_SECRET=<client-secret>
# AUTH_COGNITO_HOST=cognito-idp.your-region.amazonaws.com/your-user-pool-id

# Okta
# AUTH_OKTA_CLIENT_ID=your-client-id
# AUTH_OKTA_CLIENT_SECRET=<client-secret>
# AUTH_OKTA_ISSUER=https://your-domain.okta.com/oauth2/default

DEFAULT_DEPLOYMENT="deployment_id"

# Public client-owned settings, returned unchanged in client-config as config.customVariables.
# JSON object only; unset, blank or invalid values fall back to {}. Never include secrets.
# Keys are interpreted by clients, not the BFF. Restart the BFF after changing.
# CUSTOM_CLIENT_VARIABLES='{"supportUrl":"https://example.com/help","experimentalPanel":false}'

# Application identifiers GET /api/v1/client-config serves as appId (comma-separated).
# Each must be lowercase a-z, 0-9 and hyphens, 1-63 characters, not starting with a
# hyphen, or startup fails; at most 16. Unset or blank means ai-dial-chat; the former
# chat-ui is accepted as an alias of ai-dial-chat here and in requests. An unlisted
# identifier is 400. List both identifiers while a frontend switches, e.g.:
# CLIENT_CONFIG_APP_IDS=launchpad,ai-dial-chat
# Managed configuration from Config Studio (off by default; see docs/managed-config-schema.md).
# Shadow mode reads and compares without changing responses; active applies the listed keys.
# MANAGED_CONFIG_MODE=shadow
# MANAGED_CONFIG_INSTANCES=ai-dial-chat=chat-dev
# MANAGED_CONFIG_API_KEY=your-config-studio-reader-key
# MANAGED_CONFIG_MAX_STALENESS_SECONDS=900
# Only with MANAGED_CONFIG_MODE=active:
# MANAGED_CONFIG_ACTIVE_KEYS=onboarding.hints

# Server-only allowlist of exact GET Core paths exposed through
# GET /api/v1/custom-api/:operationId. Unset, empty or whitespace-only (the
# default) means no custom operations are enabled. JSON object, at most 16 KiB
# UTF-8 and 64 operations; invalid values fail startup. See
# apps/chat-api/README.md "Custom Core API operations" before enabling.
# CUSTOM_CORE_API_CONFIG='{"version":1,"operations":[{"id":"data-products","method":"GET","corePath":"/data-products"}]}'

# Server-only registry of GitHub/GitLab Markdown sources served read-only through
# GET /api/v1/content-sources/:sourceId (+ /document, /asset). Unset, empty or
# whitespace-only (the default) means no sources: every id answers 404. JSON
# object, at most 64 KiB and 64 sources; invalid values fail startup. Never sent
# to the browser. See apps/chat-api/README.md "Content sources" for token scopes
# and egress before enabling.
# CONTENT_SOURCES_CONFIG='{"version":1,"sources":[{"id":"release-notes","title":"Release notes","provider":"github","repository":"epam/ai-dial-chat","ref":"development","kind":"directory","path":"docs/releases","sort":"name-desc","date":"created","credentialId":"github-docs"},{"id":"guide","title":"Guide","provider":"gitlab","baseUrl":"https://gitlab.example.com","repository":"group/project","ref":"main","kind":"file","path":"docs/guide.md","credentialId":"gitlab-docs"}]}'
# Secret token map referenced by a source's credentialId (GitHub: Authorization
# Bearer, GitLab: PRIVATE-TOKEN). Every referenced id must exist. Never logged.
# CONTENT_SOURCES_CREDENTIALS='{"github-docs":"<token>","gitlab-docs":"<token>"}'
# How long a fetched listing, document, asset or commit date stays fresh (default
# 30 minutes); an expired entry is still served if the refresh fails.
# CONTENT_SOURCES_CACHE_TTL_MS=1800000
# Deadline of each upstream GitHub/GitLab request (default 10 seconds).
# CONTENT_SOURCES_TIMEOUT_MS=10000

# Structured announcement banner: a bold title followed by supporting description text,
# shown in a dismissible top-of-app banner. Setting either value switches the banner to
# the structured layout; leaving both unset falls back to ANNOUNCEMENT_HTML_MESSAGE below.
#
# The title is plain text and is never interpreted as markup. The description is
# sanitized to <a>, <b>, <strong>, <em>, <br>, <span> only, and its links are forced to
# open in a new tab. Text that overruns the banner width is silently truncated with an
# ellipsis, so keep both values short.
#
# Dismissal is keyed by content and persists across browser restarts: changing the title
# or the description re-shows the banner for users who dismissed the previous version.
# Also managed through Config Studio as announcement.title (up to 200 characters) and
# announcement.description (up to 2,000). An explicit value here wins; remove it to let
# the published text apply.
# ANNOUNCEMENT_TITLE=🎉 Welcome to DIAL! 🎉
# ANNOUNCEMENT_DESCRIPTION=Explore our AI offerings with your data and see how they boost your productivity!

# Announcements listed in the popover behind the banner's "+N announcements" pill.
# JSON array of { title, description?, link?: { label, href }, severity? }. The pill is
# hidden when this is unset or contains no valid entries.
#
# severity is "info" (default) or "warning" and lets clients mark maintenance or outage
# notices; Chat does not render it. An unknown value is logged and treated as "info" —
# the entry is kept.
#
# Validation is drop-and-log, never fatal: an entry is dropped if its title is blank, or
# if it has a link whose label is blank or whose href is not an absolute http(s) URL.
# An entry with no link at all is kept and renders without a call to action. Descriptions
# are sanitized like the banner description; titles and link labels are plain text.
# At most 10 entries are returned; the rest are dropped with a warning. Rejected entries
# are only visible in the server log — there is no UI feedback.
# Also managed through Config Studio as announcement.items: at most 10 entries, titles up
# to 200, descriptions up to 2,000, link labels up to 100 and link addresses up to 2,048
# characters. A valid array here wins; malformed JSON never shadows the published list.
# ANNOUNCEMENTS=[{"title":"Upcoming maintenance: DIAL 1.49","description":"Saturday 10:00 UTC","severity":"warning"},{"title":"We have upgraded to DIAL 1.43 🎉","description":"Check what's new:","link":{"label":"Changelog","href":"https://your-site.example.com/changelog"}}]

# Onboarding hints: a one-time, step-by-step tour for users who have not seen them.
# JSON array of { id, target, title, description? }. target is one of the anchors
# in docs/onboarding-anchors.md, which also says what each one highlights.
# "pages" limits a hint to home, projects, scheduled-tasks, catalog, file-manager,
# settings, usage or editors; without it the hint shows on home (new chat and
# conversations) only. On its page, a hint whose element is not on screen waits for it.
# Steps follow the array order; each page runs a tour of the unseen hints on screen.
# Next marks the passed hint seen at once, so a tour left halfway resumes where it
# stopped; Done marks the shown hints seen; Close/Escape marks the shown hints seen
# and shows no more cards until the next visit; Skip marks every hint seen.
# The browser remembers seen ids in localStorage, so a new or renamed id is shown again.
# Titles and descriptions are plain text. Invalid entries are dropped with a warning.
# Also managed through Config Studio as onboarding.hints: at most 50 hints, titles
# up to 100 and descriptions up to 500 characters. An explicit value here wins.
# ONBOARDING_HINTS=[{"id":"new-chat","target":"new-chat","title":"Start a new chat","description":"Each chat keeps its own history and model."},{"id":"composer","target":"conversation-input","title":"Ask anything","description":"Type a question or attach files here."},{"id":"catalog-create","target":"catalog-create","title":"Create your own agent","pages":["catalog"]}]

# Legacy announcement banner, still supported. Rendered centered, with the same
# content-keyed dismissal. Ignored when ANNOUNCEMENT_TITLE or ANNOUNCEMENT_DESCRIPTION
# is set. Unset/empty hides the banner.
#
# It is not truncated to one line and accepts <p> and <u> on top of the description's
# inline tags, so a multi-paragraph message renders as stacked centered lines. Anything
# else is stripped: style attributes go, and unlike the description no target/rel is
# added for you, so write target="_blank" rel="noreferrer" on links that leave the page.
# Links are underlined by the app.
# ANNOUNCEMENT_HTML_MESSAGE=Welcome to <a href="https://your-site.example.com">DIAL</a>!

# Operator-authored plain-text copy shown below the greeting heading on the new-chat start
# screen (e.g. "Your secure, all-in-one AI assistant for web search, document analysis,
# research, brainstorming, and more."). Never interpreted as markup. Unset/blank hides it.
# Also managed through Config Studio as welcomeScreen.description (up to 1,000
# characters). An explicit, non-blank value here wins; remove it to let the published
# text apply.
# WELCOME_SCREEN_DESCRIPTION=Your secure, all-in-one AI assistant for web search, document analysis, research, brainstorming, and more.

# Operator-authored HTML message shown in the footer of the chat input area (desktop) and
# mobile user panel. Supports %%VERSION%% token replaced with the resolved chat version
# (CHAT_VERSION when set, otherwise the workspace root package.json version).
# Sanitized server-side (allowlist: a span strong u em br p). Unset/empty hides the footer.
# FOOTER_HTML_MESSAGE=<p>Need help? <a href="https://your-support-site.example.com">Contact support</a>.</p>

# Version string shown in the footer's corner version label, substituted for the
# %%VERSION%% footer token, and reported as `version` by GET /api/health. Set this from
# CI/CD to surface the deployed build. When unset or blank, the workspace root package.json version
# is used, so a version label is always shown.
# CHAT_VERSION=2026.08.10-a1b2c3d

# DIAL Configuration
# DIAL_CORE_URL=https://your-dial-core-url.example.com
# DIAL_API_VERSION=2024-10-21
# DIAL_API_KEY=your-dial-api-key
# Server-only key for GET /api/v1/model-catalog (separate from DIAL_API_KEY). Its Core role must be
# in every restricted model's userRoles; Core has no list-only permission, so keep its limits minimal.
# Unset or blank disables the catalog routes (404) and sets config.modelCatalogAvailable=false.
# MODEL_CATALOG_API_KEY=your-model-catalog-api-key
# Deployment kinds GET /api/v1/user/{limits,usage} report when the request names
# none (comma-separated: model, application). Default reports both; set `model`
# for the model-only report DIAL Core returned before application cost attribution.
# USER_USAGE_DEPLOYMENT_TYPES=model,application

# Themes
# THEMES_CONFIG_URL=https://your-themes-config-url.example.com
# Public URL of the themes host, as absolute deployment icon_url values name it.
# Exposed as config.themesBaseUrl so the chat loads those icons through
# /api/themes/icon, once each. Unset: no field, absolute icon URLs load as listed.
# THEMES_PUBLIC_URL=https://themes.example.com

# File Transfer
# FILE_UPLOAD_MAX_BYTES=536870912
# FILE_TRANSFER_TIMEOUT_MS=30000
# ARCHIVE_DOWNLOAD_CONCURRENCY=32
# ARCHIVE_UPLOAD_MAX_BYTES=536870912
# ARCHIVE_UPLOAD_MAX_FILES=1000
# ARCHIVE_UPLOAD_MAX_UNCOMPRESSED_BYTES=2147483648
# ARCHIVE_UPLOAD_TIMEOUT_MS=300000

# Conversation publish
# PUBLISH_ATTACHMENTS_MAX_FILES=1000

# Skills domain ingress limits
# SKILL_UPLOAD_MAX_FILES=100
# SKILL_FILE_UPLOAD_MAX_BYTES=1048576
# SKILL_UPLOAD_MAX_TOTAL_BYTES=16777216
# SKILL_TRANSFER_TIMEOUT_MS=60000
# SKILL_ARCHIVE_UPLOAD_MAX_BYTES=20971520

# Max duration (ms) an active generation may run before the backend forces it
# to a terminal Error state and releases its registry entry, independent of
# the client connection.
# MAX_GENERATION_DURATION_MS=1800000

# Bounds subscriber and resource release, never ownership, when a generation's
# terminal write is dispatched but never settles: after this many ms the entry
# releases its attach subscribers, timer and runtime tracking, but keeps its
# registry key (state=settling) so a replacement is never admitted over an
# unsettled write.
# GENERATION_FINALIZE_TIMEOUT_MS=60000

# Bounds how long a completion may wait in preparation (hidden-model check,
# capability resolution, conversation read, start-state save) before SSE
# headers are sent. On expiry the request fails with 503 and attach
# subscribers are released, but the registry key is kept (state=settling)
# until the abandoned DIAL Core call settles; the remote call is not cancelled.
# GENERATION_PREPARATION_TIMEOUT_MS=30000

# Voice / ASR
# ASR_MODEL=your-asr-deployment-id
# TRANSCRIBE_SIZE_LIMIT_BYTES=5242880

# Shared utility model for conversation naming and AI text refinement.
# Naming uses DIAL_API_KEY and requires LLM_CONVERSATION_NAMING_ENABLED=true.
# Refinement uses caller credentials and a 30-second timeout, independently of naming.
# Unset or blank UTILITY_MODEL disables refinement availability.
# UTILITY_MODEL=your-utility-deployment-id
# Optional prompt overrides (server-only). Unset, empty or whitespace-only values
# retain built-in defaults. Nonblank values replace the entire corresponding prompt.
# Quote multiline values; restart chat-api after changing configuration.
# TEXT_REFINEMENT_SKILL_DESCRIPTION_PROMPT=
# TEXT_REFINEMENT_SKILL_INSTRUCTIONS_PROMPT=
# TEXT_REFINEMENT_SCHEDULED_TASK_DESCRIPTION_PROMPT=
# TEXT_REFINEMENT_SCHEDULED_TASK_INSTRUCTIONS_PROMPT=
# TEXT_REFINEMENT_APPLICATION_DESCRIPTION_PROMPT=
# TEXT_REFINEMENT_APPLICATION_NAME_PROMPT=
# TEXT_REFINEMENT_TOOLSET_DESCRIPTION_PROMPT=
# TEXT_REFINEMENT_PROMPT_DESCRIPTION_PROMPT=
# TEXT_REFINEMENT_PROMPT_INSTRUCTIONS_PROMPT=
# TEXT_REFINEMENT_PROJECT_DESCRIPTION_PROMPT=
# TEXT_REFINEMENT_PROJECT_INSTRUCTIONS_PROMPT=
# CONVERSATION_NAMING_SYSTEM_PROMPT=
# TRANSCRIPTION_PROMPT=
# Example (double-quoted \n also works as a line break):
# CONVERSATION_NAMING_SYSTEM_PROMPT="Create a concise conversation title.
# Return only the title, in the language of the conversation."
# LLM_CONVERSATION_NAMING_ENABLED=false
# UTILITY_NAMING_TIMEOUT_MS=10000

# Server-side kill switch for the OpenAI Responses API (server-only; default false).
# Even when a deployment reports features.responsesApi=true, Responses is only used
# when this is also true — otherwise Chat Completions is used.
# RESPONSES_API_ENABLED=false

# Start eligible Responses generations as DIAL Core background jobs (server-only;
# default false). Needs RESPONSES_API_ENABLED=true and DIAL Core >= 0.48.0, and applies
# only to deployments that report features.responsesApi=true and list "openaiResponses"
# in their interfaces. Affects new generations only; in-flight background jobs stay
# recoverable when this is turned off.
# RESPONSES_BACKGROUND_ENABLED=false

# Start-page celebration module: halloween or new-year. Missing or none disables
# seasonal decorations, icon replacement, click scenes, and secret chat phrases.
# IDs use lowercase kebab-case; the frontend safely ignores unsupported IDs.
# Each event owns its visuals and random scenes; effects clear on navigation.
# Users can turn it off or on in Settings > Preferences.
# Also managed through Config Studio as ui.activeEventId, so the season can change
# without a restart. An explicit value here, none included, wins; remove it to let the
# published event apply.
# UI_EVENT=none

# Default state of the Settings > Preferences celebrations switch for users who
# have not saved a choice of their own (default true). Only false, 0 or no turn
# it off, which makes a configured UI_EVENT opt-in. A choice the user saved wins.
# Also managed through Config Studio as ui.celebrationsEnabledByDefault; a value here wins.
# UI_EVENT_ENABLED_BY_DEFAULT=true

# External celebration packs from <THEMES_CONFIG_URL>/celebrations/. bundled
# (default) plays compiled scenes only and makes no celebration request;
# prefer-external also takes the listed scenes from published packs. Listed external
# events come from their pack in either mode.
# Unset these variables, or remove one entry, to roll back.
# Also managed through Config Studio as ui.celebrationDelivery.*; the four keys are
# activated together, a value here wins for its part, and an explicit
# UI_EVENT_DELIVERY_MODE=bundled keeps every built-in scene. THEMES_CONFIG_URL, the
# pack source, is never managed.
# UI_EVENT_DELIVERY_MODE=bundled
# Change the revision to restart a scene playing under the previous policy.
# UI_EVENT_DELIVERY_REVISION=0
# Comma-separated eventId/sceneId pairs of compiled events (at most 64). A pair
# naming a bundled scene replaces it; any other pair adds that pack scene to the
# event's declared secret pool (Santa) or click pool (e.g. new-year/bullfinch-couriers).
# UI_EVENT_EXTERNAL_SCENES=new-year/snowman-delivery,new-year/gift-wrapping
# After a compatible runtime and ordinary New Year pack containing Santa are
# deployed, keep UI_EVENT=new-year and UI_EVENT_DELIVERY_MODE=prefer-external.
# Append new-year/santa-history-delivery to the existing UI_EVENT_EXTERNAL_SCENES entries;
# Santa joins the "happy new year" secret pool and is never selected by gift clicks.
# Existing gift-click and secret scenes remain available.
# Older clients omit only Santa because its new capability is scene-level.
# To roll back, remove only new-year/santa-history-delivery and change the delivery revision.
# Reload open clients to pick up changed configuration/catalog; a revision change
# cancels old playback once the host receives it, without mutating cached versions.
# Comma-separated event IDs without a compiled module (at most 64).
# UI_EVENT_EXTERNAL_EVENTS=company-anniversary

# Enables operator-default selection priority and pins DEFAULT_DEPLOYMENT at the
# top of the deployment picker. Client-visible feature flag; default false.
# DEFAULT_DEPLOYMENT_PINNED=false

# Lets custom/application visualizer iframes send SEND_MESSAGE text as a user
# message in their conversation. Client-visible feature flag; default false.
# Enable only for trusted visualizers — they can send messages as the user.
# ALLOW_VISUALIZER_SEND_MESSAGES=false

# Shows the token/cost usage-limits control in the conversation input.
# Client-visible feature flag; default false.
# Also managed through Config Studio as features.usageLimitsControl, with an optional
# availability window and role targeting. An explicit true here overrides a published
# enabled: false, and an explicit false switches the control off whatever is published;
# remove it to let the published policy apply.
# USAGE_LIMITS_CONTROL_ENABLED=false

# Lets the chat read the DIAL Core org units and the user's permissions in them,
# so a save or publish panel can tell which folders a user may use and a unit
# writer can save an application, toolset, prompt or skill straight into a unit
# folder.
# Gates GET /api/v1/org-units and POST /api/v1/catalog/:entityType/:entityId/copy-to-org-unit.
# Client-visible feature flag; default false.
# ORG_UNITS_ENABLED=false

# Percentage (integer 1–99) of a capped day/week/month token or cost limit at
# which the usage banner appears above the conversation input (shown while
# USAGE_LIMITS_CONTROL_ENABLED is false). Banner only — the usage dial keeps
# its fixed 75% mark. Exposed as config.usageLimitsWarningThresholdPercent.
# Also managed through Config Studio as usageLimits.warningThresholdPercent. An explicit
# value here wins; remove it to let the published value apply.
# USAGE_LIMITS_WARNING_THRESHOLD_PERCENT=75

# DIAL Core's spendingLimits.mode, which DIAL Core does not report: off, shadow
# or enforce. Set it to the value DIAL Core runs. off keeps today's Usage page;
# shadow adds the caller's budgets as not yet enforced; enforce shows only the
# budgets and withholds the role cost limit from the usage banner and dial.
# Exposed as config.spendingLimitsMode.
# Also managed through Config Studio as usageLimits.spendingLimitsMode. An explicit value
# here wins. Publish the mode before you remove this variable: an active key with nothing
# published, or a stale publication, shows off.
# SPENDING_LIMITS_MODE=off

# Catalog
# FEATURED_MODEL_IDS=your-featured-model-id-1,your-featured-model-id-2

# Additional content locales for toolset/application Name/Description translations
# (comma-separated BCP-47 tags; a malformed tag fails startup; the primary 'en' is dropped).
# Present but empty switches the list off, overriding the deprecated AVAILABLE_LOCALES.
# ADDITIONAL_CONTENT_LOCALES=de,fr-FR
# Deprecated 0.x name, read only when ADDITIONAL_CONTENT_LOCALES is absent (logs a warning).
# AVAILABLE_LOCALES=["ar","en"]
# HIDDEN_ENTITY_TAGS=hidden-tag-1,hidden-tag-2

# Security / CSP
# Enforce the strict nonce policy (default). Use report-only only as a compatibility
# rollback: it keeps the earlier inline-CSS allowance enforced and reports the strict
# candidate. Legacy frontend builds without the nonce marker start only in report-only mode.
CSP_MODE=enforce

# Allow inline style="..." attributes (style-src-attr 'unsafe-inline') in the enforced
# policy. Off by default. Needed by embedded apps that bundle Monaco (e.g. the Quick Apps
# JSON editor), which positions its lines with style attributes. <style> elements stay
# nonce-only and inline scripts stay blocked.
# CSP_ALLOW_STYLE_ATTRIBUTES=false

# Comma-separated HTTP(S) origins allowed by connect-src for external PDF/Office
# previews. Applies to enforced and report-only policies; upstream CORS still applies.
# Origins only, no paths; a leading *. subdomain pattern is supported.
# PDF previews also use browser credentials for matching external origins.
# Use HTTPS outside local development: HTTP can send non-Secure cookies in
# plaintext. CORS does not protect cookies in transit.
# Credentialed PDF requests reject redirects; upstream credentialed CORS and
# browser cookie policy still apply.
# ALLOWED_CONNECT_ORIGINS=https://documents.example.com
# Optional HTTPS destination owned by your CSP reporting service. No collector is
# built into chat-api. Reports can contain document URLs; configure retention there.
# CSP_REPORT_URI=https://reports.example.com/csp
# Comma-separated list of origins allowed to be embedded in an iframe (CSP frame-src,
# frame-ancestors, and X-Frame-Options coordination). Also the overlay-mode host-origin
# allowlist consumed by chat-overlay (see libs/chat-overlay/README.md). Empty/unset
# denies all embedding (frame-ancestors 'none', X-Frame-Options: SAMEORIGIN kept on).
# Each entry is an exact origin (scheme://host[:port]) or a single leading `*.`
# wildcard-label origin (scheme://*.host[:port]) to allow a whole subdomain family,
# e.g. https://*.example.com matches https://portal.example.com but not the bare
# https://example.com.
# ALLOWED_IFRAME_ORIGINS=

# Whether the chat-overlay embedded runtime mode (libs/chat-overlay) is reachable.
# Has no effect unless ALLOWED_IFRAME_ORIGINS is also non-empty.
# OVERLAY_ENABLED=false

# Serve the overlay sandbox static app at /overlay-sandbox/.
# Intended for development/test environments only.
# OVERLAY_SANDBOX_ENABLED=false

# File Manager
# Comma-separated subset of: all,my_files,shared,organization. Defaults to all four when unset.
# "all" is shown only when at least two of my_files/shared/organization are enabled.
# The order of the list is ignored: tabs always appear as All, My files, Shared, Organization.
# A list with no source tab (for example only "all") falls back to all four, with a warning.
# Also managed through Config Studio as fileManager.availableTabs. An explicit value with
# a known id wins; remove it to let the published list apply.
# FILE_MANAGER_AVAILABLE_TABS=all,my_files,shared,organization

# UI Feature toggles
# When set, becomes the complete list of enabled OverlayFeature values.
# Supports both positive flags (header, likes) and modifier/hide flags.
# ENABLED_UI_FEATURES=

# Catalog creation roles (server-only; see README "Catalog creation roles")
# JSON object restricting who may create catalog entities, by type
# (custom-app, schema-app, toolset, prompt, skill) and by exact schema id.
# A user passes a rule holding any listed role; a schema app needs both its
# schema-app rule and its exact schema rule. No admin bypass. Unset means
# unrestricted. Independent of ENABLED_UI_FEATURES; enforced in the UI only.
# Invalid JSON or an unknown key fails boot. Restart after changing.
# CATALOG_CREATION_ROLES={"types":{"skill":["skill-authors"]},"schemas":{"<schema id>":["team-A"]}}

# DIAL_CORE_EXTERNAL_URL=

# Interactive toolset sign-in during chat completion (client-channel)
# LIVE_CHAT_INTERACTION_ENABLED=false
# Comma-separated roles allowed to use it when the feature above is enabled; unset/empty means unrestricted
# LIVE_CHAT_INTERACTION_ENABLED_ROLES=

# Projects page, its sidebar navigation entry, and GET /api/v1/projects
# PROJECTS_ENABLED=false
# Comma-separated roles allowed to use it when the feature above is enabled; unset/empty means unrestricted
# PROJECTS_ENABLED_ROLES=
# Project context limits for POST /api/v1/projects, also sent to the browser.
# Keep them at or below DIAL Core's complexResource.types.projects limits
# (built-in: 5 MiB per file, 64 MiB total). TOTAL must be >= FILE and
# <= 66060288 (63 MiB: the BFF's 64 MiB project read limit minus 1 MiB for PROJECT.md).
# PROJECT_CONTEXT_FILE_MAX_BYTES=1048576
# PROJECT_CONTEXT_TOTAL_MAX_BYTES=10485760
# Comma-separated context file extensions (lower-case, no dot)
# PROJECT_CONTEXT_ALLOWED_EXTENSIONS=csv,pdf,xlsx

# Scheduled Tasks page and its sidebar navigation entry (UI shell only)
# SCHEDULED_TASKS_ENABLED=false
# Comma-separated roles allowed to use it when the feature above is enabled; unset/empty means unrestricted
# SCHEDULED_TASKS_ENABLED_ROLES=
# SCHEDULER_APP_ID=your-scheduler-application-id
# SCHEDULER_SERVICE_ID=your-scheduler-oauth-service-id
# SCHEDULER_SERVICE_TIMEOUT_MS=10000

# DIAL Analytics (ADAS) for GET /api/v1/user/usage/history. Server-side only; never sent to the browser.
# Unset disables the route (it answers reason "not_configured"). ADAS must run SECURITY_MODE=oidc with a
# row policy on dial_usage_log — see the chat-api README "Usage history (DIAL Analytics)".
# ANALYTICS_URL=http://ai-dial-analytics:8080
# ANALYTICS_TIMEOUT_MS=10000

# Custom Visualizers
# JSON array of custom visualizer registry entries. Each entry mounts an <iframe> (with a sandbox
# attribute) at the given URL to render attachments whose MIME type(s) match. Registering a URL
# grants that origin iframe privileges (downloads, popups, clipboard, fullscreen) — only list vetted visualizers.
# Each visualizer URL's origin must ALSO appear in ALLOWED_IFRAME_ORIGINS: CSP frame-src is built from that
# variable alone, so an unlisted origin is blocked by the browser and the canvas never renders. That list also
# drives frame-ancestors, so the origin you add gains permission to embed this app as well.
# `title` is the postMessage namespace shared with the visualizer app; it MUST equal the `appName`
# argument passed to ChatVisualizerConnector inside the iframe app — a mismatch means the iframe
# silently never receives data.
# CUSTOM_VISUALIZERS=[{"title":"my-viz","url":"https://viz.example.com","contentType":"application/x-my-viz,application/x-my-viz-v2"}]

# Application Visualizers
# JSON OBJECT (not an array) keyed by application id — the effective deployment id of a message.
# Every attachment an entry claims is delivered to one iframe together, rendered inline in the
# message with an expand-to-canvas control, instead of one iframe per attachment.
# `contentType` is OPTIONAL here: when set it claims only those MIME types and the rest of the
# message's attachments stay ordinary tiles; when omitted it claims every attachment carrying a URL.
# An entry takes precedence over CUSTOM_VISUALIZERS for the attachments it claims.
# The same ALLOWED_IFRAME_ORIGINS requirement and `title`/`appName` contract as above apply.
# `passAuthInfo` and `passExplicitToken` are accepted for parity with legacy Chat 0.x and do
# nothing: auth is server-side and the browser holds no access token.
# Optional booleans `borderless` (no frame border/background/header divider) and `withoutTitle`
# (hide the header title text) style the inline frame; legacy `expanded` is ignored.
# APPLICATION_VISUALIZERS={"my-app-deployment-id":{"title":"my-viz","url":"https://viz.example.com","contentType":"application/x-my-viz","height":600,"mobileHeight":400}}
