{
  "name": "@epam/chat-api",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/chat-api"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/chat-api/dist/package.json",
          "{workspaceRoot}/apps/chat-api/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/chat-api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "test": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/apps/chat-api/test-output/vitest/coverage"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "vitest run --config apps/chat-api/vitest.config.ts"
        }
      },
      "openapi-spec": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/libs/chat-api-client/openapi.json"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "cross-env SWC_NODE_PROJECT=apps/chat-api/tsconfig.app.json node -r @swc-node/register apps/chat-api/src/openapi-spec.ts"
        }
      },
      "openapi-sdk": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "openapi-spec"
        ],
        "outputs": [
          "{workspaceRoot}/libs/chat-api-client/src/generated"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "cross-env HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= npm exec openapi-generator-cli -- generate -i libs/chat-api-client/openapi.json -g typescript-fetch --reserved-words-mappings function=function -o libs/chat-api-client/src/generated --additional-properties=supportsES6=true,withoutRuntimeChecks=true,npmName=@epam/chat-api-client,npmVersion=0.0.1 && node tools/openapi/postprocess-client.mjs && npm exec prettier -- --write \"libs/chat-api-client/src/generated/src/**/*.ts\" && node tools/openapi/check-client.mjs"
        }
      },
      "openapi": {
        "executor": "nx:noop",
        "dependsOn": [
          "openapi-sdk"
        ]
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@epam/chat-api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@epam/chat-api:build:development"
          },
          "production": {
            "buildTarget": "@epam/chat-api:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@epam/ai-dial-typescript-sdk": "0.1.0-dev.35",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "archiver": "^7.0.1",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "jose": "5.10.0",
    "mime-types": "^3.0.2",
    "multer": "2.2.0",
    "openid-client": "~5.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sanitize-html": "^2.15.0",
    "tslib": "^2.3.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@types/archiver": "^6.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/sanitize-html": "^2.13.0",
    "@types/yauzl": "^3.4.0"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "multer": "2.2.0"
  }
}
