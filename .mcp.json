{
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "ai-dial-ui-kit": {
      "command": "node",
      "args": ["./node_modules/@epam/ai-dial-ui-kit/dist/mcp-server.cjs"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@0.0.76", "--browser", "chrome"]
    }
  }
}
