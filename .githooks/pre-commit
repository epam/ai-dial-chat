#!/bin/sh
# Hard gate: never let broken agent configuration or an unknown project
# breakpoint land. Relevant staged files trigger a full semantic validation.
# Bypass in emergencies with `git commit --no-verify`.

if ! command -v node >/dev/null 2>&1; then
  nvm_dir=${NVM_DIR:-"$HOME/.nvm"}

  if [ -s "$nvm_dir/nvm.sh" ]; then
    # Git clients launched from macOS GUI apps do not inherit the interactive shell's NVM PATH.
    # shellcheck disable=SC1090
    . "$nvm_dir/nvm.sh"
  fi
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: Node.js is required to validate staged agent configuration files." >&2
  exit 1
fi

files=$(git diff --cached --name-only --diff-filter=ACM | grep -E \
  '^(\.agents/skills/.*\.md|\.claude/commands/.*\.md|\.claude/rules/.*\.md|\.claude/skills/.*\.md|\.claude/settings\.json|\.cursor/rules/.*\.mdc|\.mcp\.json|AGENTS\.md|CLAUDE\.md|openspec/config\.yaml|(apps|libs)/.*\.(css|js|jsx|scss|ts|tsx))$')

[ -z "$files" ] && exit 0

node scripts/validate-agent-docs.mjs
