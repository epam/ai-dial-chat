  "panels": [
    {
      "id": 1,
      "title": "How to read this dashboard",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Routing, SSE subscriptions and conversation title delivery.** Resolution does not prove generation started. Subscription operations are not users. Time to first title is not stream duration."
      },
      "description": "Select one environment/namespace and one scrape job to avoid mixing environments or double scraping. Missing cluster labels are supported by Cluster=All. No samples is not a health signal. Capability resolution failures have no generation_api label, so this dashboard intentionally has no API filter. Unknown-event series appear only after events occur. SSE gauges count outstanding subscription operations including setup/cleanup, not users, tabs, or ordinary completion responses."
    },
    {
      "id": 30,
      "title": "Routing decisions in period (est.)",
      "type": "stat",
      "description": "Estimated count over the full selected period. Increase is calculated per source series before aggregation; rounding affects display only. Missing series remain missing.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "sum(sum by (outcome)(increase(generation_capability_resolution_total{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"}[$__range])))",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Routing decisions in period (est.)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 3
      }
    },
    {
      "id": 31,
      "title": "Routing failure share in period",
      "type": "stat",
      "description": "Fraction over the full selected period, with the original event population and positive denominator. No events gives no value. Includes failures without a generation API label.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "((sum(increase(generation_capability_resolution_total{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",outcome=\"failed\"}[$__range]))) or (0 * (sum(increase(generation_capability_resolution_total{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"}[$__range]))))) / (sum(increase(generation_capability_resolution_total{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"}[$__range])) > 0)",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Routing failure share in period"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 1,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 3
      }
    },
