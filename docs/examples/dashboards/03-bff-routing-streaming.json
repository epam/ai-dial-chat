    {
      "name": "DS_PROMETHEUS",
      "label": "Application Prometheus",
      "description": "Choose the Prometheus data source that scrapes the BFF /metrics listener and contains dial_chat_generations_active with otel_scope_name=\"dial-chat-api\". An OTLP data source may use different metric names or labels.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": null,
  "title": "DIAL BFF - Routing and Streaming",
  "description": "Select one environment/namespace and one scrape job to avoid mixing environments or double scraping. Missing cluster labels are supported by Cluster=All. No samples is not a health signal. Capability resolution failures have no generation_api label, so this dashboard intentionally has no API filter. Unknown-event series appear only after events occur. SSE gauges count outstanding subscription operations including setup/cleanup, not users, tabs, or ordinary completion responses. Conversation title panels separate time to the first title from Core read and queue time; none of them is the HTTP response duration of the stream.",
  "tags": ["dial-chat", "bff", "observability"],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "timezone": "utc",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m"]
  },
  "annotations": {
