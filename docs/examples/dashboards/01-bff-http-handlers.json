          "refId": "A",
          "expr": "sum(increase(http_server_request_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",http_route=~\"$route\",http_request_method=~\"$method\"}[$__range]))",
