  "panels": [
    {
      "id": 1,
      "title": "Scope and interpretation",
      "type": "text",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Select one environment/namespace and one scrape job to avoid mixing environments or double scraping. Missing cluster labels are supported by Cluster=All. No samples is not a health signal. Handler observations only: guard rejections, middleware failures and static responses are outside this metric. Rates reflect handler settlement, not request arrival. Generation/subscription durations are separate. Means are used because current histogram buckets are too coarse for subsecond percentiles."
      }
    },
    {
      "title": "Observed handler settlements / second by pod",
      "description": "Count of emitted handler observations per second, including streaming handlers only when they settle. Not complete ingress RPS.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "min": 0,
          "noValue": "No samples",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (namespace, pod)(rate(http_server_request_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",http_route=~\"$route\",http_request_method=~\"$method\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}} / {{pod}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2
    },
    {
      "title": "Recorded 4xx / 5xx fraction",
      "description": "Among recorded handler observations only. Guard failures are absent; after committed SSE headers, an exception status may differ from the wire status. No traffic gives no value.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "min": 0,
          "noValue": "No samples",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "((sum(rate(http_server_request_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",http_route=~\"$route\",http_request_method=~\"$method\",http_response_status_code=~\"4..\"}[$__rate_interval]))) or (0 * (sum(rate(http_server_request_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",http_route=~\"$route\",http_request_method=~\"$method\"}[$__rate_interval]))))) / (sum(rate(http_server_request_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",http_route=~\"$route\",http_request_method=~\"$method\"}[$__rate_interval])) > 0)",
          "legendFormat": "Recorded 4xx",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "B",
          "editorMode": "code",
          "expr": "((sum(rate(http_server_request_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",http_route=~\"$route\",http_request_method=~\"$method\",http_response_status_code=~\"5..\"}[$__rate_interval]))) or (0 * (sum(rate(http_server_request_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",http_route=~\"$route\",http_request_method=~\"$method\"}[$__rate_interval]))))) / (sum(rate(http_server_request_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",http_route=~\"$route\",http_request_method=~\"$method\"}[$__rate_interval])) > 0)",
          "legendFormat": "Recorded 5xx",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3
    },
    {
      "title": "Busiest routes - observed settlements / second",
      "description": "Top ten at each evaluation step; membership can change across the displayed range.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
