        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "topk(10, sum by (http_route, http_request_method)(rate(http_server_request_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",http_route=~\"$route\",http_request_method=~\"$method\"}[$__rate_interval])))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4
    },
