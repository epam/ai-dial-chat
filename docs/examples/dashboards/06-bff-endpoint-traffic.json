        "label": "Method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "definition": "label_values(dial_chat_http_response_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",http_route!=\"unmatched\"}, http_request_method)",
        "query": {
          "query": "label_values(dial_chat_http_response_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",http_route!=\"unmatched\"}, http_request_method)",
          "refId": "StandardVariableQuery"
