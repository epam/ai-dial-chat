          "expr": "(histogram_quantile(0.95, sum by (le) (rate(dial_chat_auth_refresh_duration_bucket{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"refreshed\"}[$__rate_interval])))) and ((sum(rate(dial_chat_auth_refresh_duration_bucket{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"refreshed\",le=~\"60([.]0+)?\"}[$__rate_interval]))) / (sum(rate(dial_chat_auth_refresh_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"refreshed\"}[$__rate_interval])) > 0) >= 0.95)",
          "legendFormat": "p95",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
