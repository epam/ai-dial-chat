          "refId": "A",
          "editorMode": "code",
          "expr": "(sum(rate(dial_chat_auth_refresh_duration_sum{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"refreshed\"}[$__rate_interval]))) / (sum(rate(dial_chat_auth_refresh_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"refreshed\"}[$__rate_interval])) > 0)",
