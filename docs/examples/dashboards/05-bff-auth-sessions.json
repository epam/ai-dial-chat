  "panels": [
    {
      "id": 1,
      "title": "Scope and interpretation",
      "type": "text",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Select one environment/namespace and one scrape job to avoid mixing environments or double scraping. Missing cluster labels are supported by Cluster=All. No samples is not a health signal. These counters measure the BFF's own decisions, not users or sessions: the BFF is stateless and has no server-side active-session count. One browser session produces many authorization decisions. Login starts count issued redirects, not successful sign-ins, and the time a user spends on the identity provider is outside every duration here. Only login, callback, and refresh carry a provider attribute; the Identity provider filter does not apply to the authorization and logout panels. Public routes make no authorization decision and are not counted."
      }
    },
    {
      "title": "Login redirects / second by provider",
      "description": "Redirects the BFF issued to an identity provider. Not successful sign-ins: the user may abandon the IdP page, and one person can start several. A request for an unconfigured provider is a 404 and is not counted here.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops",
          "min": 0,
          "noValue": "No samples",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (dial_chat_auth_provider)(rate(dial_chat_auth_login_started_total{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\"}[$__rate_interval]))",
          "legendFormat": "{{dial_chat_auth_provider}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2
    },
    {
      "title": "Callback outcomes / second",
      "description": "Terminal outcome of callbacks the BFF processed. validation_rejected is a refused callback (IdP error, missing or mismatched state, expired transaction cookie, unknown provider); exchange_failed is a failed code exchange with the IdP; internal_error is a BFF-side fault. Keep them apart: an IdP outage and a wave of stale callback links look nothing alike.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops",
          "min": 0,
          "noValue": "No samples",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (dial_chat_auth_outcome)(rate(dial_chat_auth_callback_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\"}[$__rate_interval]))",
          "legendFormat": "{{dial_chat_auth_outcome}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3
    },
    {
      "title": "Callback success fraction (of processed callbacks)",
      "description": "Denominator is callbacks that reached this BFF, not login starts. A user who never returned from the IdP is absent from both sides. No callbacks gives no value.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "min": 0,
          "noValue": "No samples",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "((sum(rate(dial_chat_auth_callback_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"success\"}[$__rate_interval]))) or (0 * (sum(rate(dial_chat_auth_callback_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\"}[$__rate_interval]))))) / (sum(rate(dial_chat_auth_callback_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\"}[$__rate_interval])) > 0)",
          "legendFormat": "Success among processed callbacks",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4
    },
    {
      "title": "Callback processing latency - mean, p50, p95",
      "description": "Successful callbacks only, so failed exchanges cannot distort it. Covers the BFF's own work: code exchange, optional userinfo lookup, bucket fetch, session encryption. Excludes the user's time on the IdP. Quantiles aggregate buckets and are hidden above the last finite 60s bucket.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "min": 0,
          "noValue": "No samples",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "(sum(rate(dial_chat_auth_callback_duration_sum{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"success\"}[$__rate_interval]))) / (sum(rate(dial_chat_auth_callback_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"success\"}[$__rate_interval])) > 0)",
          "legendFormat": "mean",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "B",
          "editorMode": "code",
          "expr": "(histogram_quantile(0.50, sum by (le) (rate(dial_chat_auth_callback_duration_bucket{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"success\"}[$__rate_interval])))) and ((sum(rate(dial_chat_auth_callback_duration_bucket{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"success\",le=~\"60([.]0+)?\"}[$__rate_interval]))) / (sum(rate(dial_chat_auth_callback_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"success\"}[$__rate_interval])) > 0) >= 0.50)",
          "legendFormat": "p50",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "C",
          "editorMode": "code",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(dial_chat_auth_callback_duration_bucket{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"success\"}[$__rate_interval])))) and ((sum(rate(dial_chat_auth_callback_duration_bucket{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"success\",le=~\"60([.]0+)?\"}[$__rate_interval]))) / (sum(rate(dial_chat_auth_callback_duration_count{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",dial_chat_auth_provider=~\"$auth_provider\",dial_chat_auth_outcome=\"success\"}[$__rate_interval])) > 0) >= 0.95)",
          "legendFormat": "p95",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
