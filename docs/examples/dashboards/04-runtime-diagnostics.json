    {
      "id": 10,
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "**Memory and retained work.** Select a pod. Memory kinds overlap: do not add them."
      },
      "title": "How to read this dashboard",
      "description": "Memory and outstanding operations sampled inside each backend process.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "id": 30,
      "title": "RSS at range end",
      "type": "stat",
      "description": "Instant observation at the selected range end, summed across the selected processes. Missing series remain missing. Resident memory only; do not add heap or external values.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "sum(dial_chat_process_memory{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",kind=\"rss\"})",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "RSS at range end"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
