              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "((sum(rate(generation_requests_total{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",generation_api=~\"$generation_api\",outcome=\"completed\"}[$__rate_interval]))) or (0 * (sum(rate(generation_requests_total{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",generation_api=~\"$generation_api\"}[$__rate_interval]))))) / (sum(rate(generation_requests_total{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",generation_api=~\"$generation_api\"}[$__rate_interval])) > 0)",
          "legendFormat": "Completed among terminal relays",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4
    },
