    {
      "id": 1,
      "title": "How to read this dashboard",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Conversation relays, before persistence.** Retained entries cover all APIs. Aborted does not identify user cancellation."
      },
      "description": "Select one environment/namespace and one scrape job to avoid mixing environments or double scraping. Missing cluster labels are supported by Cluster=All. No samples is not a health signal. Generation counters cover the conversation generation relay, not /chat/completions. Outcomes are recorded after the relay terminates, before persistence. Completed is not end-to-end saved success; aborted does not distinguish user stop from timeout. First-text timing starts at the upstream call and excludes preflight work; it is recorded only when the relay ends."
    },
    {
      "id": 30,
      "title": "Ended relays in period (est.)",
      "type": "stat",
      "description": "Estimated count over the full selected period. Increase is calculated per source series before aggregation; rounding affects display only. Missing series remain missing. Before persistence; excludes preflight failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "sum(sum by (generation_api, outcome)(increase(generation_requests_total{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",generation_api=~\"$generation_api\"}[$__range])))",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Ended relays in period (est.)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 3
      }
    },
    {
      "id": 31,
      "title": "Completed share in period",
      "type": "stat",
      "description": "Fraction over the full selected period, with the original event population and positive denominator. No events gives no value. Adapter-classified completion, not saved success.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "refId": "A",
          "expr": "((sum(increase(generation_requests_total{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",generation_api=~\"$generation_api\",outcome=\"completed\"}[$__range]))) or (0 * (sum(increase(generation_requests_total{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",generation_api=~\"$generation_api\"}[$__range]))))) / (sum(increase(generation_requests_total{otel_scope_name=\"dial-chat-api\",cluster=~\"$cluster\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",generation_api=~\"$generation_api\"}[$__range])) > 0)",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "Completed share in period"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 1,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "gridPos": {
        "x": 8,
