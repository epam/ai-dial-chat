          "editorMode": "code",
          "expr": "sum(rate(dial_chat_http_response_duration_count{otel_scope_name=\"dial-chat-api\",namespace=~\"$namespace\",job=~\"$job\",http_route=~\"$http_route\",http_request_method=~\"$http_method\",dial_chat_http_outcome=\"completed\"}[$__rate_interval]))",
