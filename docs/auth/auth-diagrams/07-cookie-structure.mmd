%% Cookie payload structure.
%% Plaintext is JSON; ciphertext is JWE (alg=dir, enc=A256GCM).
%% Browser sees only opaque ciphertext.

flowchart TB
    subgraph Browser["Browser cookie jar"]
        COOKIE["__Host-chat.sess<br/>HttpOnly · Secure · SameSite=Lax/None<br/>Max-Age = effective deadline minus now"]
    end

    subgraph Wire["Cookie value on the wire"]
        JWE["JWE compact<br/>protected header · encrypted key (empty)<br/>iv · ciphertext · tag"]
    end

    subgraph Plain["Decrypted plaintext (server only)"]
        P["{<br/>  v: 2,<br/>  sid: '0d3e6a...',<br/>  providerId: 'keycloak',<br/>  sub: 'user-123',<br/>  at: '...',<br/>  rt: '...',<br/>  session_exp, at_exp, optional rt_exp, iat,<br/>  claims: { roles, email }<br/>}"]
    end

    COOKIE -->|sent as-is to BFF| JWE
    JWE -->|jose compactDecrypt<br/>try active then previous key| P
    P --> CHECK["Server enforces effective deadline:<br/>RT known: min(session_exp, rt_exp)<br/>RT unknown: session_exp<br/>No RT: min(session_exp, at_exp)"]
