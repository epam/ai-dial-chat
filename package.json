    "@nx/node": "22.7.5",
    "@nx/react": "22.7.5",
    "@nx/vite": "22.7.5",
    "@nx/vitest": "22.7.5",
    "@nx/webpack": "22.7.5",
    "@openapitools/openapi-generator-cli": "^2.33.1",
