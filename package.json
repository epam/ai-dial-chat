{
  "name": "ai-dial-chat",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "nx serve chat",
    "start:api": "nx serve chat-api",
    "start:api:dev": "cd apps/chat-api && webpack-cli build --config webpack.hmr.config.js --watch --node-env=development",
    "start:all": "nx run-many --target=serve --projects=chat,chat-api --parallel",
    "build": "nx build chat",
    "build:api": "nx build chat-api",
    "build:all": "nx run-many --target=build --all",
    "test": "nx run-many -t test --all",
    "lint": "nx run-many --target=lint --all --fix && npm run format",
    "lint:check": "nx run-many --target=lint --all && npm run format:check",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "lint:affected": "nx affected --target=lint",
    "openapi": "nx run chat-api:openapi",
    "openapi:check": "node tools/openapi/check-client.mjs",
    "openapi:sdk": "nx run chat-api:openapi-sdk",
    "openapi:spec": "nx run chat-api:openapi-spec",
    "postman": "node tools/postman/generate-collection.mjs",
    "postman:refresh": "npm run openapi:spec && npm run postman",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "graph": "nx graph",
    "validate:agent-docs": "node scripts/validate-agent-docs.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
