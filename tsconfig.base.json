{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@epam/source"],
    "paths": {
      "@/*": ["apps/chat/*"],
      "@epam/conversation-input/*": ["./libs/conversation-input/*"],
      "@epam/conversation-messages/*": ["./libs/conversation-messages/*"],
      "@epam/chat-shared/*": ["./libs/chat-shared/*"]
    }
  }
}
