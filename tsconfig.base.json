{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@epam/source"],
    "paths": {
      "@/*": ["./apps/chat/*"],
      "@epam/ai-dial-conversation-input/*": ["./libs/conversation-input/*"],
      "@epam/ai-dial-conversation-messages/*": [
        "./libs/conversation-messages/*"
      ],
      "@epam/ai-dial-chat-shared/*": ["./libs/chat-shared/*"],
      "@epam/ai-dial-sidebar/*": ["./libs/sidebar/*"],
      "@epam/ai-dial-conversation-stages/*": ["./libs/conversation-stages/*"],
      "@epam/ai-dial-conversation-panel/*": ["./libs/conversation-panel/*"],
      "@epam/ai-dial-starter-buttons/*": ["./libs/starter-buttons/*"],
      "@epam/ai-dial-catalog/*": ["./libs/catalog/*"],
      "@epam/ai-dial-source-panel/*": ["./libs/source-panel/*"],
      "@epam/ai-dial-attachment-canvas/*": ["./libs/attachment-canvas/*"],
      "@epam/ai-dial-attachment-input/*": ["./libs/attachment-input/*"],
      "@epam/ai-dial-kit/*": ["./libs/ai-dial-kit/*"],
      "@epam/ai-dial-deployment-creation-form/*": [
        "./libs/deployment-creation-form/*"
      ]
    }
  }
}
