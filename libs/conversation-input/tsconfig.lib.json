{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../../dist/libs/conversation-input",
    "tsBuildInfoFile": "../../dist/libs/conversation-input/tsconfig.lib.tsbuildinfo",

    "jsx": "react-jsx",

    "declaration": true,
    "sourceMap": true,

    "module": "esnext",
    "moduleResolution": "bundler",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["node"],
    "lib": ["dom"],

    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "references": [
    {
      "path": "../chat-api-client/tsconfig.lib.json"
    },
    {
      "path": "../ai-dial-kit/tsconfig.lib.json"
    },
    {
      "path": "../chat-shared/tsconfig.lib.json"
    },
    {
      "path": "../attachment-input/tsconfig.lib.json"
    }
  ]
}
