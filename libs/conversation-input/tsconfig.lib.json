{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "../../dist/libs/conversation-input",

    "jsx": "react-jsx",

    "declaration": true,
    "sourceMap": true,

    "module": "node16",
    "moduleResolution": "node16",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["node"],
    "lib": ["dom"],

    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../chat-shared/tsconfig.lib.json"
    }
  ]
}
