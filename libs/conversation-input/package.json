{
  "name": "@epam/ai-dial-conversation-input",
  "description": "Conversation message input with model selection, attachments, voice input, and edit mode",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": "./dist/style.css",
    ".": {
      "@epam/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@epam/ai-dial-attachment-input": "*",
    "@epam/ai-dial-chat-shared": "*",
    "@tabler/icons-react": "^3.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.6",
    "@epam/ai-dial-kit": "0.0.1",
    "@epam/ai-dial-ui-kit": "^0.13.0-dev.12"
  },
  "dependencies": {
    "react-window": "^2.2.7"
  },
  "nx": {
    "tags": [
      "publishable"
    ],
    "targets": {
      "publish": {
        "command": "node tools/publish-lib.mjs {projectName} --version={args.ver} --dry={args.dry} --tag={args.tag} --development={args.development}"
      }
    }
  }
}
