{
  "name": "@epam/ai-dial-publish-panel",
  "description": "Publish-to-folder UI and state flow shared by catalog entity publish and conversation publish",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": "./dist/index.css",
    ".": {
      "@epam/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "@epam/ai-dial-chat-shared": "*",
    "@epam/ai-dial-ui-kit": "^0.15.0-dev.11",
    "@epam/ai-dial-react-file-manager": "^0.3.0-dev.4"
  },
  "nx": {
    "tags": [
      "publishable"
    ],
    "targets": {
      "publish": {
        "command": "node tools/publish-lib.mjs {projectName} --version={args.ver} --dry={args.dry} --tag={args.tag} --development={args.development}"
      }
    }
  }
}
