{
  "name": "@epam/ai-dial-mcp-apps",
  "description": "Host-agnostic MCP Apps building blocks — tool-call/message matching, the response cache, and the inline preview hook/component shared by the full-width canvas and inline surfaces",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@epam/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./constants": {
      "@epam/source": "./src/constants/mcp-protocol.ts",
      "types": "./dist/constants/mcp-protocol.d.ts",
      "import": "./dist/constants.js",
      "default": "./dist/constants.js"
    }
  },
  "peerDependencies": {
    "@epam/ai-dial-attachment-canvas": "0.0.1",
    "@epam/ai-dial-chat-shared": "0.0.1",
    "@epam/ai-dial-ui-kit": "^0.14.0-dev.15",
    "@mcp-ui/client": "^7.1.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@tabler/icons-react": "^3.44.0",
    "react": "^19.0.0"
  },
  "nx": {
    "tags": [
      "publishable"
    ],
    "targets": {
      "publish": {
        "command": "node tools/publish-lib.mjs {projectName} --version={args.ver} --dry={args.dry} --tag={args.tag} --development={args.development}"
      }
    }
  }
}
