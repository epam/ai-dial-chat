{
  "name": "@epam/ai-dial-catalog",
  "description": "Marketplace catalog component for browsing models, tools, and assistants with search, filter, and sort",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": "./dist/index.css",
    ".": {
      "@epam/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mapping": {
      "@epam/source": "./src/entry-points/mapping.ts",
      "types": "./dist/entry-points/mapping.d.ts",
      "import": "./dist/mapping.js",
      "default": "./dist/mapping.js"
    }
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "ag-grid-community": "^35.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "@epam/ai-dial-chat-shared": "*",
    "@epam/ai-dial-publish-panel": "*",
    "@epam/ai-dial-ui-kit": "^0.14.0-dev.30"
  },
  "nx": {
    "tags": [
      "publishable"
    ],
    "targets": {
      "publish": {
        "command": "node tools/publish-lib.mjs {projectName} --version={args.ver} --dry={args.dry} --tag={args.tag} --development={args.development}"
      }
    }
  }
}
