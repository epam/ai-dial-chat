{
  "openapi": "3.0.0",
  "paths": {
    "/api/themes": {
      "get": {
        "description": "Fetches the complete theme configuration from the external themes service. Returns a JSON object containing all available themes with their properties, colors, and icon references. Results are cached for 5 minutes.",
        "operationId": "getThemes",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successfully retrieved theme configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThemeConfigResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Theme configuration not found on the external service"
          },
          "502": {
            "description": "External theme service returned an error response"
          },
          "503": {
            "description": "Theme service is unavailable or request timed out"
          }
        },
        "summary": "Get themes configuration",
        "tags": [
          "themes"
        ]
      }
    },
    "/api/themes/icon": {
      "get": {
        "description": "Fetches a theme icon as SVG or PNG content from the external themes service. The icon name is validated to prevent path traversal attacks - only alphanumeric characters, dashes, underscores, and dots are allowed. Results are cached for 5 minutes.",
        "operationId": "getThemeIcon",
        "parameters": [
          {
            "name": "iconName",
            "required": true,
            "in": "query",
            "description": "Icon filename (alphanumeric, dash, underscore, and dot only)",
            "schema": {
              "example": "icon-light.svg",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved icon content",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                },
                "example": "<svg xmlns=\"http://www.w3.org/2000/svg\"><circle r=\"10\"/></svg>"
              }
            }
          },
          "400": {
            "description": "Invalid icon name (validation failed or path traversal attempt)",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "statusCode": 400,
                    "message": [
                      "Icon name must contain only alphanumeric characters, dash, underscore, and dot"
                    ],
                    "error": "Bad Request"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Icon not found on the external service"
          },
          "502": {
            "description": "External theme service returned an error response"
          },
          "503": {
            "description": "Theme service is unavailable or request timed out"
          }
        },
        "summary": "Get theme icon",
        "tags": [
          "themes"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Returns a simple health check response indicating the application is running. Use this endpoint for load balancer health checks, monitoring, and deployment verification.",
        "operationId": "check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Application is healthy and responding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok",
                      "description": "Health status"
                    },
                    "timestamp": {
                      "type": "string",
                      "example": "2026-05-07T20:00:00.000Z",
                      "description": "Current server time in ISO format"
                    },
                    "version": {
                      "type": "string",
                      "example": "1.0.0",
                      "description": "Application version"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Check application health status",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/auth/providers": {
      "get": {
        "operationId": "listProviders",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Array of provider descriptors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProviderInfoDto"
                  }
                }
              }
            }
          }
        },
        "summary": "List configured identity providers",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login/{providerId}": {
      "get": {
        "operationId": "login",
        "parameters": [
          {
            "name": "providerId",
            "required": true,
            "in": "path",
            "description": "Configured identity provider ID",
            "schema": {
              "example": "local",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to identity provider"
          },
          "400": {
            "description": "Unsafe callback URL"
          },
          "404": {
            "description": "Unknown provider"
          }
        },
        "summary": "Start OIDC login flow",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/callback/{providerId}": {
      "get": {
        "operationId": "callback",
        "parameters": [
          {
            "name": "providerId",
            "required": true,
            "in": "path",
            "description": "Configured identity provider ID",
            "schema": {
              "example": "local",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to app after login"
          },
          "400": {
            "description": "State mismatch or missing tx cookie"
          },
          "502": {
            "description": "Token exchange failed"
          }
        },
        "summary": "OIDC authorization callback",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [],
        "responses": {
          "302": {
            "description": "Redirect after logout"
          }
        },
        "summary": "Log out and clear session cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileDto"
                }
              }
            }
          },
          "401": {
            "description": "No valid session"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Get current user profile",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/deployments": {
      "get": {
        "operationId": "getDeployments",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Array of deployment objects from DIAL Core",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DialDeploymentDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "502": {
            "description": "Unexpected response from DIAL Core"
          },
          "503": {
            "description": "DIAL Core is unreachable"
          }
        },
        "summary": "List all available deployments",
        "tags": [
          "deployments"
        ]
      }
    },
    "/api/deployments/{deployment}": {
      "get": {
        "operationId": "getDeployment",
        "parameters": [
          {
            "name": "deployment",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deployment object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DialDeploymentDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Deployment not found"
          },
          "502": {
            "description": "Unexpected response from DIAL Core"
          },
          "503": {
            "description": "DIAL Core is unreachable"
          }
        },
        "summary": "Get a single deployment by name",
        "tags": [
          "deployments"
        ]
      }
    },
    "/api/v1/models": {
      "get": {
        "description": "Returns the list of DIAL Core deployments visible to the authenticated session user. Proxies GET /openai/models using the caller's session access token. Results are cached server-side for 30 seconds per user.",
        "operationId": "listModels",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successfully retrieved model list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DialModelListResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated — valid session cookie required"
          },
          "403": {
            "description": "Caller lacks permission to list models"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "500": {
            "description": "Internal server error"
          },
          "502": {
            "description": "DIAL Core returned an error response"
          },
          "503": {
            "description": "DIAL Core is unavailable or timed out"
          }
        },
        "summary": "List available models",
        "tags": [
          "models"
        ]
      }
    },
    "/api/v1/models/{modelName}": {
      "get": {
        "description": "Returns a single DIAL Core deployment by name for the authenticated session user. Proxies GET /openai/models/{model_name} using the caller's session access token. Results are cached server-side for 60 seconds per user per model.",
        "operationId": "getModel",
        "parameters": [
          {
            "name": "modelName",
            "required": true,
            "in": "path",
            "description": "Model name (alphanumeric, dash, underscore, dot, colon, at-sign, and slash only)",
            "schema": {
              "example": "gpt-4o",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved model",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DialModelDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid model name — disallowed characters"
          },
          "401": {
            "description": "Not authenticated — valid session cookie required"
          },
          "403": {
            "description": "Caller lacks permission to access this model"
          },
          "404": {
            "description": "Model not found"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "500": {
            "description": "Internal server error"
          },
          "502": {
            "description": "DIAL Core returned an error response"
          },
          "503": {
            "description": "DIAL Core is unavailable or timed out"
          }
        },
        "summary": "Get model by name",
        "tags": [
          "models"
        ]
      }
    },
    "/api/chat/completions/{deployment}": {
      "post": {
        "operationId": "sendCompletion",
        "parameters": [
          {
            "name": "deployment",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat completion response from DIAL Core",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body"
          },
          "404": {
            "description": "Deployment not found"
          },
          "502": {
            "description": "Unexpected response from DIAL Core"
          },
          "503": {
            "description": "DIAL Core is unreachable"
          }
        },
        "summary": "Send a chat completion request to DIAL Core",
        "tags": [
          "chat"
        ]
      }
    },
    "/api/v1/conversations": {
      "post": {
        "description": "Creates a new conversation with an initial user message and returns it with a server-assigned ID.",
        "operationId": "createConversation",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConversationDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conversation created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body — firstMessage missing or out of range"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "summary": "Create a new conversation",
        "tags": [
          "conversations"
        ]
      },
      "get": {
        "operationId": "getConversation",
        "parameters": [
          {
            "name": "path",
            "required": true,
            "in": "query",
            "description": "Conversation path (uuid__name). May contain slashes.",
            "schema": {
              "example": "cfeaf733-4ecd-4898-ad3b-d6835c0b5fc8__My Conversation 5/19/2026",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid path"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Conversation not found"
          },
          "502": {
            "description": "DIAL Core error"
          },
          "503": {
            "description": "DIAL Core unreachable"
          }
        },
        "summary": "Get a conversation by path",
        "tags": [
          "conversations"
        ]
      },
      "put": {
        "operationId": "saveConversation",
        "parameters": [
          {
            "name": "path",
            "required": true,
            "in": "query",
            "description": "Conversation path (uuid__name). May contain slashes.",
            "schema": {
              "example": "cfeaf733-4ecd-4898-ad3b-d6835c0b5fc8__My Conversation 5/19/2026",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveConversationBodyDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversation saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid path or body"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Conversation not found"
          },
          "502": {
            "description": "DIAL Core error"
          },
          "503": {
            "description": "DIAL Core unreachable"
          }
        },
        "summary": "Save (overwrite) a conversation by path",
        "tags": [
          "conversations"
        ]
      },
      "delete": {
        "operationId": "deleteConversation",
        "parameters": [
          {
            "name": "path",
            "required": true,
            "in": "query",
            "description": "Conversation path (uuid__name). May contain slashes.",
            "schema": {
              "example": "cfeaf733-4ecd-4898-ad3b-d6835c0b5fc8__My Conversation 5/19/2026",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Conversation deleted"
          },
          "400": {
            "description": "Missing or invalid path"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Conversation not found"
          },
          "502": {
            "description": "DIAL Core error"
          },
          "503": {
            "description": "DIAL Core unreachable"
          }
        },
        "summary": "Delete a conversation by path",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/v1/conversations/metadata": {
      "get": {
        "operationId": "getConversationMetadata",
        "parameters": [
          {
            "name": "path",
            "required": true,
            "in": "query",
            "description": "Conversation path (uuid__name). May contain slashes.",
            "schema": {
              "example": "cfeaf733-4ecd-4898-ad3b-d6835c0b5fc8__My Conversation 5/19/2026",
              "type": "string"
            }
          },
          {
            "name": "permissions",
            "required": false,
            "in": "query",
            "description": "Include READ/WRITE/SHARE permissions for the requesting user",
            "schema": {
              "example": true,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationMetadataDto"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid path"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Conversation not found"
          },
          "502": {
            "description": "DIAL Core error"
          },
          "503": {
            "description": "DIAL Core unreachable"
          }
        },
        "summary": "Get metadata for a conversation",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/v1/conversations/completions": {
      "post": {
        "description": "Appends the user message to the conversation history, streams a completion from DIAL Core as SSE, and returns the raw event stream.",
        "operationId": "streamCompletion",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendCompletionDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream of completion chunks"
          },
          "400": {
            "description": "Invalid request body"
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Insufficient permissions on conversation"
          },
          "404": {
            "description": "Conversation not found"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "502": {
            "description": "DIAL Core error"
          },
          "503": {
            "description": "DIAL Core unreachable"
          }
        },
        "summary": "Stream a chat completion",
        "tags": [
          "conversations"
        ]
      }
    },
    "/api/v1/files/upload": {
      "post": {
        "description": "Uploads a file to the user bucket under uploads/{yyyy-mm-dd}/. Deduplicates filenames automatically.",
        "operationId": "uploadFile",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "No file provided"
          },
          "413": {
            "description": "File too large"
          }
        },
        "summary": "Upload a file",
        "tags": [
          "files"
        ]
      }
    },
    "/api/v1/rate": {
      "post": {
        "description": "Forwards a like/dislike rating for an assistant message to DIAL Core. Uses the authenticated session's access token as a Bearer credential.",
        "operationId": "rateMessage",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RateMessageDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Rating accepted — no content returned"
          },
          "400": {
            "description": "Invalid request body — missing or invalid fields"
          },
          "401": {
            "description": "Not authenticated — valid session cookie required"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "502": {
            "description": "DIAL Core returned an unexpected response"
          },
          "503": {
            "description": "DIAL Core is unavailable or returned a server error"
          }
        },
        "summary": "Rate an assistant message",
        "tags": [
          "rate"
        ]
      }
    }
  },
  "info": {
    "title": "Chat API",
    "description": "REST API for the chat application. Provides endpoints for theme configuration, authentication, and management. All endpoints return appropriate HTTP status codes (200, 400, 401, 403, 404, 502, 503) with descriptive error messages.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": "Health check and application status"
    },
    {
      "name": "themes",
      "description": "Theme configuration and icon management"
    },
    {
      "name": "auth",
      "description": "Authentication and session management"
    },
    {
      "name": "deployments",
      "description": "List and inspect available AI DIAL deployments"
    },
    {
      "name": "chat",
      "description": "Chat completion proxy to DIAL Core"
    },
    {
      "name": "rate",
      "description": "Submit assistant message ratings to DIAL Core"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3005",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "ThemeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "light"
          },
          "name": {
            "type": "string",
            "example": "Light Theme"
          },
          "icon": {
            "type": "string",
            "example": "icon-light.svg"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "ThemeConfigResponseDto": {
        "type": "object",
        "properties": {
          "themes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThemeDto"
            }
          }
        },
        "required": [
          "themes"
        ]
      },
      "ProviderInfoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "local"
          },
          "label": {
            "type": "string",
            "example": "Local"
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "sub": {
            "type": "string",
            "example": "user@example.com"
          },
          "providerId": {
            "type": "string",
            "example": "local"
          },
          "claims": {
            "type": "object",
            "additionalProperties": true
          },
          "bucket": {
            "type": "string",
            "example": "default-bucket"
          }
        },
        "required": [
          "sub",
          "providerId",
          "claims",
