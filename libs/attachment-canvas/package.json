{
  "name": "@epam/ai-dial-attachment-canvas",
  "description": "Canvas viewer for rendering attachment content — images, PDFs, JSON, markdown, and plain text",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": "./dist/style.css",
    ".": {
      "@epam/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@epam/ai-dial-chat-shared": "0.0.1",
    "@epam/ai-dial-sidebar": "0.0.1",
    "@epam/ai-dial-ui-kit": "^0.13.0-dev.24",
    "@epam/pdf-highlighter-kit": ">=0.0.14",
    "@tabler/icons-react": "^3.44.0",
    "react": "^19.0.0",
    "react-json-view-lite": "^2.5.0",
    "@epam/ai-dial-react-pdf-highlighter": "0.2.0-dev.22"
  },
  "dependencies": {},
  "nx": {
    "tags": [
      "publishable"
    ],
    "targets": {
      "publish": {
        "command": "node tools/publish-lib.mjs {projectName} --version={args.ver} --dry={args.dry} --tag={args.tag} --development={args.development}"
      }
    }
  }
}
