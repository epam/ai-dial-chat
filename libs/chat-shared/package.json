{
  "name": "@epam/ai-dial-chat-shared",
  "description": "Shared domain models, utilities, and UI components for AI DIAL Chat libraries",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@epam/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "@epam/ai-dial-ui-kit": "0.12.0-dev.36",
    "vitest": "~4.1.0",
    "@tabler/icons-react": "^3.44.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "dependencies": {
    "classnames": "2.5.1",
    "tailwind-merge": "^3.6.0"
  },
  "nx": {
    "tags": [
      "publishable"
    ],
    "targets": {
      "publish": {
        "command": "node tools/publish-lib.mjs {projectName} --version={args.ver} --dry={args.dry} --tag={args.tag} --development={args.development}"
      }
    }
  }
}
