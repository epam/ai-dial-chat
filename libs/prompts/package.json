{
  "name": "@epam/ai-dial-prompts",
  "description": "Host-agnostic UI for picking a favorite prompt and resolving its {{parameter}} placeholders before it is inserted into a chat message",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": "./dist/index.css",
    ".": {
      "@epam/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./parameters-popup": {
      "@epam/source": "./src/entry-points/parameters-popup.ts",
      "types": "./dist/entry-points/parameters-popup.d.ts",
      "import": "./dist/parameters-popup.js",
      "default": "./dist/parameters-popup.js"
    }
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "@epam/ai-dial-catalog": "*"
  },
  "peerDependencies": {
    "@epam/ai-dial-chat-shared": "*",
    "@epam/ai-dial-ui-kit": "^0.15.0-dev.19",
    "react": "^19.2.8"
  },
  "nx": {
    "tags": [
      "publishable",
      "type:ui"
    ],
    "targets": {
      "publish": {
        "command": "node tools/publish-lib.mjs {projectName} --version={args.ver} --dry={args.dry} --tag={args.tag} --development={args.development}"
      }
    }
  }
}
