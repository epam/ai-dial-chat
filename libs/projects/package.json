{
  "name": "@epam/ai-dial-projects",
  "description": "Presentational Projects page shell, New and Edit project form, and project view — searchable, sortable grid of the projects available to a user",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": "./dist/index.css",
    ".": {
      "@epam/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@epam/ai-dial-attachment-input": "*",
    "@epam/ai-dial-builder-form": "*",
    "@tabler/icons-react": "^3.44.0",
    "@uiw/react-markdown-preview": "^5.2.1",
    "@uiw/react-md-editor": "^4.1.1"
  },
  "peerDependencies": {
    "@epam/ai-dial-chat-shared": "*",
    "@epam/ai-dial-ui-kit": "^0.16.0-dev.45",
    "react": "^19.2.8"
  },
  "nx": {
    "tags": [
      "publishable"
    ],
    "targets": {
      "publish": {
        "command": "node tools/publish-lib.mjs {projectName} --version={args.ver} --dry={args.dry} --tag={args.tag} --development={args.development}"
      }
    }
  }
}
