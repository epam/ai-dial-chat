{
  "name": "@epam/ai-dial-prompt-editor",
  "description": "Host-agnostic form for authoring a reusable prompt, with an inline folder picker",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": "./dist/index.css",
    ".": {
