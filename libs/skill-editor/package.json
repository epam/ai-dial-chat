{
  "name": "@epam/ai-dial-skill-editor",
  "description": "Host-agnostic form for authoring a DIAL Skill, with an inline supporting-file tree",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": "./dist/index.css",
    ".": {
      "@epam/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "@uiw/react-markdown-preview": "^5.2.1",
    "@uiw/react-md-editor": "^4.1.1",
    "@epam/ai-dial-editor-builder": "*"
  },
  "peerDependencies": {
    "@epam/ai-dial-chat-shared": "*",
    "@epam/ai-dial-ui-kit": "^0.14.0-dev.30",
    "@epam/ai-dial-react-file-manager": "^0.2.0-dev.10",
    "react": "^19.0.0"
  },
  "nx": {
    "tags": [
      "publishable"
    ],
    "targets": {
      "publish": {
        "command": "node tools/publish-lib.mjs {projectName} --version={args.ver} --dry={args.dry} --tag={args.tag} --development={args.development}"
      }
    }
  }
}
